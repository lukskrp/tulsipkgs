Find QML modules on the QML import path too, as KDE's ECM does since 6.32. On Nix
every module is in its own store path, which the build environment puts on
QML2_IMPORT_PATH; without this, a REQUIRED QML module is never found.

--- a/modules/ECMFindQmlModule.cmake.in
+++ b/modules/ECMFindQmlModule.cmake.in
@@ -17,6 +17,9 @@ if (QT_MAJOR_VERSION EQUAL "6")
     set(KDE_QMLDIR "${KDE_INSTALL_FULL_QMLDIR}/${MODULEDIR}")
     find_file(QMLDIR_FILE qmldir ${KDE_QMLDIR} NO_CACHE)
+    if (NOT QMLDIR_FILE)
+        find_file(QMLDIR_FILE qmldir PATHS ENV QML_IMPORT_PATH ENV QML2_IMPORT_PATH PATH_SUFFIXES "${MODULEDIR}" NO_CACHE)
+    endif()
     if (NOT QMLDIR_FILE) # Check the install destination, the QT_PLUGIN_PATH might not be set up correctly at this point
         # Check the Qt installation
         ecm_query_qt(qt_qml_dir QT_INSTALL_QML)
