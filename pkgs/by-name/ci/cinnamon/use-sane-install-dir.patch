Install files/usr and files/etc under the prefix instead of /.
Regenerated for Cinnamon 6.8, which excludes files from that install.

--- a/meson.build	2026-11-12 00:39:20.702872860 +0200
+++ b/meson.build	2026-11-12 00:39:20.753130396 +0200
@@ -267,11 +267,24 @@
     excluded_files += ['usr/share/cinnamon/cinnamon-settings/modules/cs_user.py']
 endif
 
+# NixOS: install files/usr into the prefix and files/etc into prefix/etc
+# instead of the filesystem root.
+excluded_usr_files = []
+foreach f : excluded_files
+    excluded_usr_files += f.substring(4)  # strip 'usr/'
+endforeach
+
+install_subdir(
+    'files/usr',
+    install_dir: get_option('prefix'),
+    strip_directory: true,
+    exclude_files : excluded_usr_files
+)
+
 install_subdir(
-    'files',
-    install_dir: '/',
+    'files/etc',
+    install_dir: join_paths(get_option('prefix'), 'etc'),
     strip_directory: true,
-    exclude_files : excluded_files
 )
 
 session_files = ['cinnamon.session']
