+def list_displays():
+    """[(output name, label)] of the connected displays, as the settings daemon names them."""
+    try:
+        gi.require_version("CinnamonDesktop", "3.0")
+        from gi.repository import CinnamonDesktop
+        screen = CinnamonDesktop.RRScreen.new(Gdk.Screen.get_default())
+    except Exception as e:
+        print(f"Night Light: could not list displays: {e}")
+        return []
+    displays = []
+    for output in screen.list_outputs():
+        if output.get_crtc() is None:
+            continue
+        name = output.get_name()
+        label = _("Built-in display") if output.is_builtin_display() else (output.get_display_name() or name)
+        displays.append((name, name if label == name else f"{label} ({name})"))
+    return displays
+
+
+class AdjustmentRow(SettingsWidget):
+    """One slider for one display's brightness or gamma (display-adjustments)."""
+
+    def __init__(self, settings, output, index, label, lower, upper, fmt, scale):
+        super().__init__()
+        self.settings, self.output, self.index = settings, output, index
+        self.pack_start(Gtk.Label(label=label, xalign=0), False, False, 0)
+        self.content_widget = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, lower, upper, 0.01)
+        self.content_widget.set_hexpand(True)
+        self.content_widget.set_size_request(300, -1)
+        self.content_widget.connect("format-value", lambda _s, v: fmt % (v * scale))
+        self.content_widget.add_mark(1.0, Gtk.PositionType.BOTTOM, None)
+        self.content_widget.set_value(self.current()[index])
+        self.content_widget.connect("value-changed", self.on_changed)
+        self.pack_end(self.content_widget, True, True, 0)
+        self.show_all()
+
+    def current(self):
+        return self.settings.get_value("display-adjustments").unpack().get(self.output, (1.0, 1.0))
+
+    def on_changed(self, scale):
+        values = list(self.current())
+        values[self.index] = round(scale.get_value(), 2)
+        adjustments = self.settings.get_value("display-adjustments").unpack()
+        if values == [1.0, 1.0]:
+            adjustments.pop(self.output, None)
+        else:
+            adjustments[self.output] = tuple(values)
+        self.settings.set_value("display-adjustments", GLib.Variant("a{s(dd)}", adjustments))
+
