+/* Ocimum: the person's brightness (0.3-1) and gamma (0.5-2) for this display,
+ * from display-adjustments; (1, 1) when it isn't listed. */
+static void
+ccm_session_get_adjustment (CsdColorState *state,
+                            GnomeRROutput *output,
+                            gdouble *brightness,
+                            gdouble *gamma)
+{
+        GVariant *adjustments;
+        const gchar *name;
+
+        *brightness = 1.0;
+        *gamma = 1.0;
+        name = gnome_rr_output_get_name (output);
+        if (state->settings == NULL || name == NULL)
+                return;
+        adjustments = g_settings_get_value (state->settings, "display-adjustments");
+        if (!g_variant_lookup (adjustments, name, "(dd)", brightness, gamma)) {
+                *brightness = 1.0;
+                *gamma = 1.0;
+        }
+        g_variant_unref (adjustments);
+        *brightness = CLAMP (*brightness, 0.3, 1.0);
+        *gamma = CLAMP (*gamma, 0.5, 2.0);
+}
+
+/* Ocimum: one ramp entry, curve value (0-1) through gamma, white point and brightness. */
+static guint32
+ccm_session_adjust (gdouble value, gdouble channel, gdouble brightness, gdouble gamma)
+{
+        value = pow (CLAMP (value, 0.0, 1.0), 1.0 / gamma) * channel * brightness;
+        return (guint32) (CLAMP (value, 0.0, 1.0) * (gdouble) 0xffff);
+}
