 }
 
+static gboolean
+night_light_pause_ended_cb (gpointer user_data)
+{
+        CsdNightLight *self = CSD_NIGHT_LIGHT (user_data);
+        self->pause_id = 0;
+        night_light_recheck (self);
+        return G_SOURCE_REMOVE;
+}
+
+/* Ocimum: TRUE while night-light-paused-until is in the future; then a one-shot
+ * timeout rechecks when it ends. */
+static gboolean
+night_light_paused (CsdNightLight *self, GDateTime *dt_now)
+{
+        gint64 until = g_settings_get_int64 (self->settings, "night-light-paused-until");
+        gint64 now = g_date_time_to_unix (dt_now);
+
+        if (self->pause_id != 0) {
+                g_source_remove (self->pause_id);
+                self->pause_id = 0;
+        }
+        if (until <= now)
+                return FALSE;
+        self->pause_id = g_timeout_add_seconds ((guint) MIN (until - now + 1, G_MAXUINT),
+                                                night_light_pause_ended_cb, self);
+        return TRUE;
+}
+
 static void
 night_light_recheck (CsdNightLight *self)
 {
@@ -275,6 +305,13 @@ night_light_recheck (CsdNightLight *self)
                 return;
         }
 
+        /* Ocimum: paused (the applet's "Pause for an hour") */
+        if (night_light_paused (self, dt_now)) {
+                g_debug ("night light paused, resetting");
+                csd_night_light_set_active (self, FALSE);
+                return;
+        }
+
         /* schedule-mode */
         switch (g_settings_get_enum (self->settings, "night-light-schedule-mode")) {
         case NIGHT_LIGHT_SCHEDULE_ALWAYS_ON:
@@ -563,6 +600,10 @@ csd_night_light_finalize (GObject *object)
 
         poll_timeout_destroy (self);
         poll_smooth_destroy (self);
+        if (self->pause_id != 0) {
+                g_source_remove (self->pause_id);
+                self->pause_id = 0;
+        }
 
         g_clear_object (&self->settings);
         g_clear_pointer (&self->datetime_override, g_date_time_unref);
